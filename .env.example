# CROWDGUARD v2.0 Configuration Environment Template

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# SQLite Persistence Path
DATABASE_URL=sqlite:///./data/surveillance.db

# Vision Core Settings
YOLO_MODEL_NAME=yolov8n.pt
DEFAULT_CONF_THRESHOLD=0.25
DEFAULT_FRAME_STRIDE=2
DEFAULT_INFERENCE_SIZE=640

# Risk Engine Heuristic Weights (Sum to 1.0)
WEIGHT_DENSITY=0.35
WEIGHT_GROWTH=0.20
WEIGHT_MOTION_ANOMALY=0.25
WEIGHT_CONGESTION=0.20

# Privacy Preservation Mode (none, face_blur, full_anonymize)
DEFAULT_PRIVACY_MODE=none

# Monocular Perspective Weight (1.0 = standard, >1.0 = compensate distant horizon)
PERSPECTIVE_FAR_SCALE=1.8
PERSPECTIVE_NEAR_SCALE=0.8

# Upload Constraints
MAX_UPLOAD_SIZE_MB=150

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
